PORT=8000
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="weather_analytics"
MODEL="Xenova/bge-small-en-v1.5"

# OpenRouter AI Translation & Reasoning Key
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.0-flash-lite-001" # Or meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat

# Official India Meteorological Department (IMD) API Gateway (https://api.imd.gov.in)
# Register at api.imd.gov.in to obtain your x-api-key and Authorization tokens.
# If left blank, MausamVani automatically parses real-time IMD RSS bulletins.
IMD_API_KEY=""
IMD_AUTH_TOKEN=""

# Official Twitter / X Developer API v2 (Optional)
# If left blank, MausamVani crawls open social streams (Reddit & Mastodon Fediverse).
TWITTER_BEARER_TOKEN=""
